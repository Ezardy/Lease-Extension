:root {
}

.product__preview {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-grow: 1;
    align-self: center;
    aspect-ratio: 1;
    filter: grayscale(1);
}

.product__shadow {
    filter: drop-shadow(-2.77 -3.55 0 rgba(0, 0, 0, 0.18));
}

.product__selected #product__background {
    filter: hue-rotate(1.49) drop-shadow(-3 -3 0 rgba(0, 0, 0, 0.502));
}
