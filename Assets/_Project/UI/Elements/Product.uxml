        </ui:VisualElement>
        <Aniki.UI.Elements.IconLabel name="product__price" icon="project://database/Assets/_Project/Sprites/Parts/tooth.png?fileID=-3683004140809926483&amp;guid=aa34443700b33ba42be168db5f8137fe&amp;type=3#tooth_0" label="100" class="product__shadow" style="height: 25%; color: var(--text-color); top: 6%; left: 6%;"/>
    </ui:VisualElement>
</ui:UXML>
